{
  "name": "senator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:server": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "npm run lint --workspaces",
    "db:deploy": "npm run db:deploy -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "engines": {
    "node": ">=22.9"
  }
}
