generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model News {
  id         Int      @id @default(autoincrement())
  date       DateTime @db.Date
  title      String
  text       String
  image      String
  paragraphs String[]
  gallery    String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date(sort: Desc)])
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
}

model Lead {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String
  comment   String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([createdAt(sort: Desc)])
}

enum SectionStatus {
  SELLING
  PLANNED
  SOLD
  COMING_SOON
}

// id — номер секції на карті ЖК
model Section {
  id         Int           @id
  status     SectionStatus @default(PLANNED)
  price      Int?
  floors     Int           @default(9)
  apartments Apartment[]
  updatedAt  DateTime      @updatedAt
}

// Планування: одне на всі поверхи секції
model Apartment {
  id        String          @id
  sectionId Int
  section   Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rooms     Int
  area      Float
  // вершини багатокутника квартири на зображенні плану
  points    Json
  units     ApartmentUnit[]

  @@index([sectionId])
}

// Конкретна квартира: планування на певному поверсі
model ApartmentUnit {
  id          Int       @id @default(autoincrement())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  floor       Int
  available   Boolean   @default(true)

  @@unique([apartmentId, floor])
}

// Один рядок (id = 1): контакти ЖК
model SiteSettings {
  id        Int      @id @default(1)
  phone     String
  address   String
  hours     String
  socials   Json
  updatedAt DateTime @updatedAt
}
