# ===== База даних (PostgreSQL) — ОБОВ'ЯЗКОВО =====
# Локальний Postgres (напр. з Docker, див. README):
#   DATABASE_URL=postgresql://senator:senator@localhost:5432/senator
# Neon: рядок підключення БЕЗ "-pooler" у хості (потрібен для міграцій)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Необов'язково: окремий прямий (не pooler) рядок для міграцій.
# Якщо не задано — береться DATABASE_URL з прибраним "-pooler".
# DATABASE_URL_UNPOOLED=

# ===== Адмін-панель — ОБОВ'ЯЗКОВО =====
# Пароль адмін-панелі (лише на сервері!)
ADMIN_PASSWORD=
# Довгий випадковий рядок для підпису сесії (необов'язково, інакше береться ADMIN_PASSWORD)
SESSION_SECRET=

# ===== Сервер =====
PORT=3001
# Скільки проксі стоїть перед сервером (Vercel + балансувальник хостингу зазвичай 2)
TRUST_PROXY=2

# ===== Telegram-сповіщення про нові заявки — необов'язково =====
# Якщо порожні — заявки зберігаються, просто без сповіщень
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
